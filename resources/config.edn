{:env            #keyword #or [#env APP_ENV "dev"]
 :webserver/port #long #or [#env PORT 3001]

 :database {:dbtype "postgres"
            :dbname #or [#env DB-NAME "postgres"]
            :username #or [#env DB-USER "postgres"]
            :password #or [#env DB-PASS "postgres"]
            :host #or [#env DB-HOST "localhost"]
            :port #or [#env DB-PORT 5432]}

 ;; SENTRY_DSN is unset in dev/test on purpose: the sentry component treats a
 ;; missing dsn as "stay disabled" instead of erroring, so local runs and the
 ;; test suite never need Sentry configured. traces-sample-rate controls
 ;; Performance Monitoring (what fraction of requests get traced); it's only
 ;; read when a dsn is set. 1.0 traces everything -- lower it (e.g. via
 ;; SENTRY_TRACES_SAMPLE_RATE=0.2) if trace volume becomes a cost concern.
 :sentry {:dsn #or [#env SENTRY_DSN nil]
          :traces-sample-rate #or [#env SENTRY_TRACES_SAMPLE_RATE 1.0]}}

